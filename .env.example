# Copy to .env.local (local dev) or add as Environment Variables in Vercel.
# Browser-safe values only — never put the Supabase secret key or an access token here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair (public, browser-safe)
VITE_FIREBASE_VAPID_KEY=
